APP_NAME="BSC Distribution"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Public HTTPS origin (Cloudflare named tunnel). Use YOUR_APP_HOSTNAME, never geobeer.ge.
# SANCTUM_STATEFUL_DOMAINS=YOUR_APP_HOSTNAME,localhost,localhost:5173,127.0.0.1:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1:5173,127.0.0.1:8080

# Trust Cloudflare/reverse-proxy hops. Use * only on the office origin behind the tunnel.
TRUSTED_PROXIES=*

# --- ERP / FMG (LAN SQL Server; never publish port 1433) ---
ERP_PROVIDER=fmg
ERP_COMPANY=default
ERP_TIMEZONE=Asia/Tbilisi
FMG_WRITES_ENABLED=false

FMG_SQL_SERVER=
FMG_SQL_PORT=1433
FMG_SQL_DATABASE=
FMG_SQL_USERNAME=
FMG_SQL_PASSWORD=
FMG_SQL_ENCRYPT=yes
# Development-only exception. Do not disable certificate validation in production silently.
FMG_SQL_TRUST_SERVER_CERTIFICATE=false
FMG_SQL_LOGIN_TIMEOUT=5
FMG_AUDIT_USERNAME=

# Cloudflare named tunnel (server-side secrets only; never commit tokens).
# YOUR_APP_HOSTNAME is a separate domain on Cloudflare DNS. Do not use geobeer.ge.
CLOUDFLARE_TUNNEL_NAME=bsc-distribution
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_CREDENTIALS_FILE=
CLOUDFLARE_PUBLIC_HOSTNAME=YOUR_APP_HOSTNAME

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
