APP_NAME="BSC Distribution"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Office VPN / LAN HTTPS origin (Caddy). Laravel itself stays on 127.0.0.1:8080.
APP_URL=https://gbc.office.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Same-origin SPA on https://gbc.office.local (Caddy). Vite localhost is for developers only.
SANCTUM_STATEFUL_DOMAINS=gbc.office.local,localhost,localhost:5173,127.0.0.1:5173,127.0.0.1:8080

# Trust the local TLS reverse proxy (Caddy). Use * only on this office origin.
TRUSTED_PROXIES=*

# --- ERP / FMG (LAN SQL Server; never publish port 1433) ---
ERP_PROVIDER=fmg
ERP_COMPANY=default
ERP_TIMEZONE=Asia/Tbilisi
FMG_WRITES_ENABLED=false

FMG_SQL_SERVER=
FMG_SQL_PORT=1433
FMG_SQL_DATABASE=
FMG_SQL_USERNAME=
FMG_SQL_PASSWORD=
FMG_SQL_ENCRYPT=yes
# Development-only exception. Do not disable certificate validation in production silently.
FMG_SQL_TRUST_SERVER_CERTIFICATE=false
FMG_SQL_LOGIN_TIMEOUT=5
# Office origin without ODBC 17/18: Native Client 11 Windows auth. Leave username/password empty.
# FMG_ODBC_DSN='Driver={SQL Server Native Client 11.0};Server=localhost\FMGSQL;Database=SBS_RSF;Trusted_Connection=yes'
FMG_ODBC_DSN=
FMG_AUDIT_USERNAME=

# --- Price list catalog ---
# Read live from the office host on every request. The PHP service account needs read access.
# Single quotes only: dotenv rejects backslash escapes inside double quotes.
PRICE_LIST_PATH='E:\PRICE LIST.pdf'

# Cloudflare named tunnel — deferred. Leave empty. Do not install cloudflared yet.
# YOUR_APP_HOSTNAME would be a separate domain later; never geobeer.ge.
# CLOUDFLARE_TUNNEL_NAME=bsc-distribution
# CLOUDFLARE_TUNNEL_ID=
# CLOUDFLARE_TUNNEL_CREDENTIALS_FILE=
# CLOUDFLARE_PUBLIC_HOSTNAME=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
